{
    "intents": [
      {
        "tag": "greet",
        "patterns": ["Hi", "Hello", "Hey", "Good morning", "What's up"],
        "responses": ["Hello!", "Hi there!", "Hey! How can I help you today?"]
      },
      {
        "tag": "goodbye",
        "patterns": ["Bye", "See you later", "Goodbye", "Catch you later"],
        "responses": ["Goodbye!", "See you soon!", "Take care!"]
      },
      {
        "tag": "thanks",
        "patterns": ["Thanks", "Thank you", "Much appreciated", "Thanks a lot"],
        "responses": ["You're welcome!", "No problem!", "Glad I could help!"]
      },
      {
        "tag": "help",
        "patterns": ["I need help", "Can you help me?", "I have a problem", "Support"],
        "responses": ["Sure, I'm here to help. What's the issue?", "Let me know what you need assistance with."]
      },
      {
        "tag": "services",
        "patterns": ["What services do you offer?", "Tell me about your services", "What can you do?"],
        "responses": ["I can help you with account queries, payments, or general support."]
      },
      {
        "tag": "check_status",
        "patterns": ["Check my order", "What's the status of my request?", "Track my request"],
        "responses": ["Can you please provide your order/request ID?", "I'll need your request ID to check that."]
      },
      {
        "tag": "fallback",
        "patterns": [],
        "responses": ["Sorry, I didn’t understand that. Can you rephrase?", "I'm not sure what you mean."]
      }
    ]
  }
  